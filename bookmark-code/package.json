{
  "name": "bookmark-code",
  "displayName": "bookmark_code",
  "description": "コード行をブックマークする",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bookmarks-container",
          "title": "Bookmarks",
          "icon": "$(bookmark)"
        }
      ]
    },
    "views": {
      "bookmarks-container": [
        {
          "id": "bookmarksList",
          "name": "Bookmarks",
          "icon": "$(bookmark)"
        }
      ]
    },
    "commands": [
      {
        "command": "bookmarks.add",
        "title": "Add Bookmark"
      },
      {
        "command": "bookmarks.remove", 
        "title": "Remove Bookmark"
      },
      {
        "command": "bookmarks.editLabel",
        "title": "Edit",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "editor/lineNumber/context": [
        {
          "command": "bookmarks.add",
          "when": "editorLineNumber not in bookmarks.lines",
          "group": "inline"
        },
        {
          "command": "bookmarks.remove",
          "when": "editorLineNumber in bookmarks.lines",
          "group": "inline"
        }
      ],
      "view/item/context": [
        {
          "command": "bookmarks.editLabel",
          "when": "view == bookmarksList && viewItem == bookmark",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
